# Token de @BotFather
BOT_TOKEN=

# Cada cuántos segundos reviso si cambió la foto de los canales registrados
POLL_INTERVAL_SECONDS=300

# Dónde se guarda el estado (canal -> pack de emojis)
DATA_FILE=data/channels.json

# Dónde se guardan los packs animados (usuario -> pack)
ANIM_DATA_FILE=data/animated.json

# Nombre visible de los packs de emojis en Telegram (opcional)
# PACK_TITLE=Free Promotion Lists - @Valkyria02_Pro_bot

# Nombre visible del pack de emojis animados (opcional; por defecto el de arriba + " · Animados")
# ANIM_PACK_TITLE=Free Promotion Lists - Emojis animados

# Emojis de ejemplo de los menús (fuente, paleta, fondo y borde)
# Dónde se cachean sus ids
EXAMPLES_DATA_FILE=data/examples.json
# Usuario dueño del pack de ejemplos (opcional; por defecto, quien abra el asistente)
# EXAMPLES_OWNER_ID=123456789
# Nombre visible del pack de ejemplos (opcional)
# EXAMPLE_PACK_TITLE=Free Promotion Lists · Ejemplos
